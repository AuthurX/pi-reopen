{
  "name": "@ellieyujin/pi-reopen",
  "license": "MIT",
  "version": "1.0.7",
  "description": "Resume and restore your Pi coding agent sessions as WezTerm tabs after the terminal closes. Registers open Pi sessions and reopens them with original cwd and conversation. Linux, macOS, Windows, WSL.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AuthurX/pi-reopen.git"
  },
  "homepage": "https://github.com/AuthurX/pi-reopen#readme",
  "bugs": {
    "url": "https://github.com/AuthurX/pi-reopen/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "tag": "latest"
  },
  "type": "module",
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi",
    "pi-coding-agent",
    "pi-reopen",
    "resume",
    "session",
    "session-resume",
    "session-recovery",
    "workspace",
    "restore",
    "restore-session",
    "continue",
    "wezterm",
    "terminal",
    "tabs",
    "multiplexer",
    "wsl",
    "windows",
    "linux",
    "macos"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "files": [
    "extensions",
    "src",
    "bin",
    "README.md",
    "README.zh-CN.md",
    "CHANGELOG.md",
    "docs",
    "!docs/promotion"
  ],
  "pi": {
    "extensions": [
      "./extensions/index.ts"
    ],
    "image": "https://raw.githubusercontent.com/AuthurX/pi-reopen/main/assets/preview.png"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=1.5.0",
    "@earendil-works/pi-tui": ">=1.5.0"
  },
  "bin": {
    "pi-reopen": "bin/pi-reopen.js"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "test:platform": "node --test test/platforms.test.mjs test/extension.test.mjs test/recent.test.mjs",
    "test:integration": "PI_REOPEN_INTEGRATION=1 node --test test/integration.test.mjs",
    "verify-pack": "node scripts/verify-pack.mjs",
    "discovery-report": "node scripts/discovery-report.mjs",
    "prepublishOnly": "npm test"
  }
}
