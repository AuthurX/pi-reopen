{
  "name": "@ellieyujin/pi-reopen",
  "license": "MIT",
  "version": "0.3.0",
  "description": "Restore recorded Pi sessions in WezTerm tabs on Linux, macOS, Windows and WSL; includes a Pi extension and standalone CLI.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AuthurX/pi-workspace.git"
  },
  "homepage": "https://github.com/AuthurX/pi-workspace#readme",
  "bugs": {
    "url": "https://github.com/AuthurX/pi-workspace/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "tag": "latest"
  },
  "type": "module",
  "keywords": [
    "pi-package",
    "pi-extension",
    "workspace",
    "wezterm",
    "wsl"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "files": [
    "extensions",
    "src",
    "bin",
    "README.md",
    "docs"
  ],
  "pi": {
    "extensions": [
      "./extensions/open-all.ts"
    ],
    "image": "https://raw.githubusercontent.com/AuthurX/pi-workspace/main/assets/preview.png"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=1.5.0 <2.0.0",
    "@earendil-works/pi-tui": ">=1.5.0 <2.0.0"
  },
  "bin": {
    "pi-reopen": "bin/pi-reopen.js"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "test:platform": "node --test test/platforms.test.mjs test/extension.test.mjs test/recent.test.mjs",
    "prepublishOnly": "npm test"
  }
}
